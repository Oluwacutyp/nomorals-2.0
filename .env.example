# ── NoMorals Core configuration ────────────────────────────────────────────
# Copy to `.env` (or export in your shell). Nothing here is required to run:
# the system boots fully offline against the Mock provider.
#
# Every variable is also settable as NM_<SECTION>_<KEY>, e.g. NM_LLM_TIMEOUT=120

# ── General ────────────────────────────────────────────────────────────────
NM_HOME=~/.nomorals              # data root: db, blobs, models, backups, logs
NM_PROFILE=workstation           # workstation | laptop | termux
NM_LOG_LEVEL=INFO
NM_LOG_FILE=logs/nomorals.log

# ── Storage ────────────────────────────────────────────────────────────────
NM_DB_PATH=data/nomorals.db
NM_DB_WAL=true
NM_BACKUP_DIR=backups
NM_BACKUP_KEEP=14
NM_BACKUP_GIT_REPO=              # e.g. git@github.com:you/nm-backups.git

# ── LLM providers ──────────────────────────────────────────────────────────
# Active provider when nothing else is specified.
NM_LLM_PROVIDER=mock             # mock | openai_compat | hf_serverless | llama_cpp

# OpenAI-compatible endpoints: vLLM, Ollama, LM Studio, OpenRouter, llama.cpp server
NM_OPENAI_BASE_URL=http://localhost:11434/v1
NM_OPENAI_API_KEY=
NM_OPENAI_MODEL=dolphin-2.9-llama3-8b

# Hugging Face (https://huggingface.co/settings/tokens)
HF_TOKEN=
NM_HF_BASE_URL=https://api-inference.huggingface.co
NM_HF_MODEL=cognitivecomputations/dolphin-2.9.1-llama-3-8b
# Dedicated Inference Endpoint, if you run one.
NM_HF_ENDPOINT_URL=

# Embeddings
NM_EMBED_PROVIDER=hashing        # hashing (offline) | openai_compat | hf_serverless
NM_EMBED_MODEL=

# ── Concurrency ────────────────────────────────────────────────────────────
NM_THREADS=8                     # thread pool size (0 = cpu_count)
NM_PROCESSES=0                   # process pool size (0 = cpu_count/2, termux: disabled)
NM_MAX_SUBAGENTS=64

# ── Budgets ────────────────────────────────────────────────────────────────
NM_BUDGET_WALL_SECONDS=3600
NM_BUDGET_TOKENS=2000000
NM_BUDGET_CHILDREN=256

# ── API server ─────────────────────────────────────────────────────────────
NM_API_HOST=0.0.0.0
NM_API_PORT=8731
NM_API_TOKEN=                    # bearer token; empty = localhost-only, no auth

# ── Social (official APIs only) ────────────────────────────────────────────
NM_SOCIAL_MASTODON_DOMAIN=
NM_SOCIAL_MASTODON_TOKEN=
NM_SOCIAL_BLUESKY_HANDLE=
NM_SOCIAL_BLUESKY_APP_PASSWORD=
NM_SOCIAL_TELEGRAM_TOKEN=
NM_SOCIAL_DISCORD_WEBHOOK=
NM_SOCIAL_X_API_KEY=
NM_SOCIAL_X_API_SECRET=
NM_SOCIAL_X_ACCESS_TOKEN=
NM_SOCIAL_X_ACCESS_SECRET=
NM_SOCIAL_REDDIT_CLIENT_ID=
NM_SOCIAL_REDDIT_CLIENT_SECRET=
